# OpenAI Platform API key, used for both chat and optional RAG embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Restaurant search uses free OpenStreetMap data; no restaurant key needed.
# Optional stable secret to preserve browser sessions across server restarts.
FLASK_SECRET_KEY=
